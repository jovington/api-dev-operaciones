APP_NAME=Orovalle Platform API
APP_VERSION=0.1.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080,http://partes_operaciones.lan.orvana.com.bo,https://partes_operaciones.lan.orvana.com.bo

MONGODB_DATABASE=orovalle_platform
OPERACIONES_DATABASE=Operaciones
GRAVIMETRIA_DATABASE=griphonv2
GRAVIMETRIA_COLLECTION=datacollector
MONGODB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=orovalle_admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-password
MONGODB_URI=mongodb://orovalle_admin:replace-with-a-strong-password@mongodb:27017/orovalle_platform?authSource=admin